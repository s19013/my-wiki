# これをリポジトリ直下に .env.production としてコピーして値を埋める（git には入れない）
#   cp deploy/.env.production.example .env.production

# --- Caddy ---
SITE_ADDRESS=sundlf.com
# acme: Let's Encrypt / internal: 自己署名（切り替え前の確認用）
TLS_MODE=acme
# 必須（空だと Caddy が起動しない）。証明書の期限切れ通知などが届く
ACME_EMAIL=

# --- Laravel ---
APP_NAME=my-wiki
APP_ENV=production
# php artisan key:generate --show で作る
APP_KEY=
APP_DEBUG=false
APP_URL=https://sundlf.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=my-wiki
DB_USERNAME=my-wiki
# 下の MARIADB_PASSWORD と同じ値にする
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# メールは未設定（旧サーバーも同じ）
MAIL_MAILER=log

# --- MariaDB（初回起動時だけ使われる。後から変えても反映されない） ---
MARIADB_DATABASE=my-wiki
MARIADB_USER=my-wiki
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# バックアップ
BACKUP_S3_BUCKET=
